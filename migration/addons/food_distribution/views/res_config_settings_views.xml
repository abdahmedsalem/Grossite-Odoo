<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_form_view_inherited" model="ir.ui.view">
        <field name="name">res.config.settings.form.view.inherited.food.distribution</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Food Distribution" name="food_distribution" logo="/food_distribution/static/description/icon.png">
                    <block title="Traceability" name="food_distribution_traceability_block">
                        <setting id="food_distribution_food_drinks_labels_setting" help="Show food ingredients, allergens, nutrition and food labels for this company.">
                            <field name="x_module_food_drinks_labels"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
    <record id="action_food_guide" model="ir.actions.act_url">
        <field name="name">Food Distribution Guide</field>
        <field name="url">/food_distribution/static/description/guide.html</field>
        <field name="target">new</field>
    </record>
    <menuitem id="food_guide_menu" name="Food Distribution Guide" parent="stock.menu_stock_config_settings" action="action_food_guide" sequence="95" groups="stock.group_stock_manager"/>
</odoo>
