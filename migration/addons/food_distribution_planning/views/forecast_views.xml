<odoo>
    <record id="forecast_list" model="ir.ui.view"><field name="name">food.production.forecast.list</field><field name="model">food.production.forecast</field><field name="arch" type="xml"><list><field name="date_start"/><field name="date_end"/><field name="product_id"/><field name="quantity"/><field name="bom_id"/><field name="production_id"/><field name="state"/><field name="company_id" groups="base.group_multi_company"/></list></field></record>
    <record id="forecast_form" model="ir.ui.view"><field name="name">food.production.forecast.form</field><field name="model">food.production.forecast</field><field name="arch" type="xml"><form><header><button name="action_create_production" type="object" string="Create Manufacturing Order" class="oe_highlight" invisible="production_id" groups="mrp.group_mrp_manager"/><field name="state" widget="statusbar"/></header><sheet><group><field name="company_id" groups="base.group_multi_company" readonly="production_id"/><field name="product_id" readonly="production_id"/><field name="bom_id" readonly="production_id" domain="[('product_tmpl_id', '=', product_tmpl_id)]"/><field name="product_tmpl_id" invisible="1"/><field name="quantity" readonly="production_id"/><field name="date_start" readonly="production_id"/><field name="date_end" readonly="production_id"/><field name="production_id"/></group></sheet><chatter/></form></field></record>
    <record id="forecast_pivot" model="ir.ui.view"><field name="name">food.production.forecast.pivot</field><field name="model">food.production.forecast</field><field name="arch" type="xml"><pivot><field name="product_id" type="row"/><field name="date_start" type="col" interval="week"/><field name="quantity" type="measure"/></pivot></field></record>
    <record id="forecast_action" model="ir.actions.act_window"><field name="name">Food Production Forecasts</field><field name="res_model">food.production.forecast</field><field name="view_mode">list,form,pivot</field></record>
    <menuitem id="forecast_menu" name="Food Production Forecasts" parent="mrp.menu_mrp_root" action="forecast_action" sequence="45" groups="mrp.group_mrp_user"/>
</odoo>
