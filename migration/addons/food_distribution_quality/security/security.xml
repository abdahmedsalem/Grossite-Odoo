<odoo>
    <record id="mrp.group_mrp_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('quality_control_oca.group_quality_control_user'))]"/>
    </record>
    <record id="mrp.group_mrp_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('quality_control_oca.group_quality_control_manager'))]"/>
    </record>
    <record id="food_quality_point_company_rule" model="ir.rule">
        <field name="name">Food quality point companies</field>
        <field name="model_id" ref="model_food_quality_point"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
